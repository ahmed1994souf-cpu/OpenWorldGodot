# Reuse the SAME Groq API key already used by PhoneAssistant.
# Do not commit a real key to GitHub. Copy this file to .env on the machine running the server.
GROQ_API_KEY=

# Current Groq chat model used by PhoneAssistant
GROQ_LLM_MODEL=openai/gpt-oss-20b

# Whisper transcription; language=None in bot.py enables automatic language detection.
GROQ_STT_MODEL=whisper-large-v3-turbo

# Arabic speech output. Groq currently offers Saudi Arabic voice synthesis.
GROQ_TTS_MODEL=canopylabs/orpheus-arabic-saudi
GROQ_TTS_VOICE=fahad

VOICE_HOST=0.0.0.0
VOICE_PORT=7860
